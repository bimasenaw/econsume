generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  name           String?
  householdSize  Int            @default(3)
  preferences    Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  inventories    Inventory[]
  purchases      Purchase[]
  predictions    Prediction[]
  shoppingLists  ShoppingList[]
  wasteLogs      WasteLog[]
  points         Int            @default(150)
  wasteScore     Float          @default(18.5)

  @@map("users")
}

model Product {
  id                 String       @id @default(uuid())
  barcode            String       @unique
  name               String
  brand              String
  category           String       // 'food', 'toiletries', 'cleaning', etc.
  ecoScore           Int          // 0 - 100
  grade              String       // 'A', 'B', 'C', 'D', 'E'
  carbonFootprint    Float        // 0.0 - 1.0 (higher is greener/less carbon)
  sourcingScore      Float        // 0.0 - 1.0
  packagingScore     Float        // 0.0 - 1.0
  certificationScore Float        // 0.0 - 1.0
  transparencyScore  Float        // 0.0 - 1.0
  certifications     String[]     // e.g. ['FSC', 'Fair Trade', 'USDA Organic', 'EcoCert']
  imageUrl           String
  price              Float
  unit               String       @default("pcs")
  avgLifespanDays    Int          @default(14)
  description        String?
  origin             String?
  ingredients        String?
  packagingType      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  inventories        Inventory[]
  purchases          Purchase[]
  predictions        Prediction[]
  wasteLogs          WasteLog[]

  @@map("products")
}

model Inventory {
  id          String    @id @default(uuid())
  userId      String
  productId   String
  quantity    Float     @default(1)
  unit        String    @default("pcs")
  expiryDate  DateTime?
  purchasedAt DateTime  @default(now())
  location    String    @default("Pantry") // 'Pantry', 'Kulkas', 'Kamar Mandi', 'Dapur'
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model Purchase {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Float
  price     Float
  date      DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("purchases")
}

model Prediction {
  id                   String   @id @default(uuid())
  userId               String
  productId            String
  predictedEmptyDate   DateTime
  confidence           Float    // 0.0 - 1.0
  urgency              String   // 'high', 'medium', 'low'
  avgDailyConsumption  Float
  daysRemaining        Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("predictions")
}

model ShoppingList {
  id          String   @id @default(uuid())
  userId      String
  generatedAt DateTime @default(now())
  items       Json     // [{ productId, name, quantity, priority, isEcoRecommended, checked, estimatedPrice, carbonSaved }]
  status      String   @default("active") // 'active', 'completed'

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shopping_lists")
}

model WasteLog {
  id        String   @id @default(uuid())
  userId    String
  productId String
  reason    String   // 'expired', 'spoiled', 'overcooked', 'other'
  quantity  Float
  date      DateTime @default(now())
  notes     String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("waste_logs")
}
